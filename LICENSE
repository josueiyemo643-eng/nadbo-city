<script>


// MENU MOBILE

function toggleMenu() {

    const menu =
        document.getElementById("navLinks");

    menu.classList.toggle("open");

}


// FORMULAIRE WHATSAPP

function sendWhatsApp(event) {

    event.preventDefault();

    const name =
        document.getElementById("name").value;

    const message =
        document.getElementById("message").value;

    const text =
        "Bonjour NADBO CITY, je suis "
        + name
        + ". "
        + message;

    const url =
        "https://wa.me/14383360224?text="
        + encodeURIComponent(text);

    window.open(url, "_blank");

}


// BOUTON LANGUE

function changeLanguage() {

    alert(
        "La version anglaise complète sera ajoutée dans la prochaine étape."
    );

}

</script>


